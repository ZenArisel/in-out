{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "An income or expense transaction record",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns this transaction"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "description": "Transaction type"
        },
        "amount": {
          "type": "number",
          "description": "Transaction amount in Thai Baht"
        },
        "category": {
          "type": "string",
          "maxLength": 100,
          "description": "Category name"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date of transaction in YYYY-MM-DD"
        },
        "note": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional description or note"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "transfer", "credit_card", "other"],
          "description": "Payment method"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["userId", "type", "amount", "category", "date", "paymentMethod"]
    },
    "MonthlyBudget": {
      "title": "MonthlyBudget",
      "description": "Monthly budget limit settings for a user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the owner"
        },
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$",
          "description": "Budget month in YYYY-MM"
        },
        "monthlyLimit": {
          "type": "number",
          "description": "Monthly budget limit"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["userId", "month", "monthlyLimit"]
    }
  },
  "firestore": {
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User income and expense transaction records"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": "MonthlyBudget",
      "description": "User monthly budget configuration"
    }
  }
}
