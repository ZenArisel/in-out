rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTransaction(data, userId) {
      return data.userId == userId &&
        data.type in ['income', 'expense'] &&
        data.amount is number &&
        data.amount > 0 &&
        data.amount < 1000000000 &&
        data.category is string &&
        data.category.size() > 0 &&
        data.category.size() <= 100 &&
        data.date is string &&
        data.date.size() == 10 &&
        data.paymentMethod in ['cash', 'transfer', 'credit_card', 'other'] &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500));
    }

    function isValidBudget(data, userId) {
      return data.userId == userId &&
        data.month is string &&
        data.month.size() == 7 &&
        data.monthlyLimit is number &&
        data.monthlyLimit >= 0 &&
        data.monthlyLimit < 1000000000;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing endpoint
    match /test/{testDoc} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // User subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User transactions
      match /transactions/{transactionId} {
        allow get, delete: if isValidId(userId) && isValidId(transactionId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(transactionId) && isOwner(userId) && isValidTransaction(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(transactionId) && isOwner(userId) && isValidTransaction(incoming(), userId) && incoming().userId == existing().userId;
      }

      // User monthly budgets
      match /budgets/{budgetId} {
        allow get, delete: if isValidId(userId) && isValidId(budgetId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(budgetId) && isOwner(userId) && isValidBudget(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(budgetId) && isOwner(userId) && isValidBudget(incoming(), userId) && incoming().userId == existing().userId;
      }
    }
  }
}
